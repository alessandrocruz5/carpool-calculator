NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Production URL used as the redirect base in auth emails (e.g. https://yourapp.vercel.app)
# Without this, magic-link emails will redirect to whatever origin the browser is on.
NEXT_PUBLIC_SITE_URL=

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:driver@example.com
# Also expose the public key to the client for PushManager.subscribe()
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Shared secret for cron-invoked routes (e.g. /api/push/send). Sent as
# the `Authorization: Bearer <CRON_SECRET>` header by vercel.json crons.
CRON_SECRET=
