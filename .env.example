NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

NEXT_PUBLIC_REQUIRE_AUTH=false

# Shared secret that authorizes write requests (trips, passengers, settings,
# gas-prices, fillups, payments). Open the app once with ?key=<DRIVER_KEY>
# to store it in localStorage on the driver's device.
DRIVER_KEY=

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:driver@example.com
# Also expose the public key to the client for PushManager.subscribe()
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Shared secret for cron-invoked routes (e.g. /api/push/send). Sent as
# the `Authorization: Bearer <CRON_SECRET>` header by vercel.json crons.
CRON_SECRET=
