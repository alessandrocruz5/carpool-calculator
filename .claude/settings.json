{
  "permissions": {
    "allow": [
      "Bash(npx next:*)",
      "mcp__claude_ai_Supabase__list_projects",
      "mcp__claude_ai_Supabase__get_cost",
      "mcp__claude_ai_Supabase__confirm_cost",
      "mcp__claude_ai_Supabase__create_branch",
      "mcp__supabase__apply_migration",
      "mcp__supabase__list_tables",
      "mcp__supabase__list_migrations",
      "mcp__supabase__execute_sql",
      "mcp__supabase__get_advisors",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh auth:*)",
      "Bash(sudo pacman:*)"
    ]
  },
  "enabledMcpjsonServers": [
    "supabase"
  ],
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$(git status --porcelain)\" ] && exit 0; npx eslint . && npx vitest run --passWithNoTests"
          }
        ]
      }
    ]
  }
}
